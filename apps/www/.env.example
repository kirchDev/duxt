# ── Nuxt public site URL ─────────────────────────────────────────────────────
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3000

# ── Open Graph images (npx nuxt-og-image generate-secret) ────────────────────
NUXT_OG_IMAGE_SECRET=

# ── Dev over a public tunnel (any value switches HMR to wss:443) ─────────────
DUXT_TUNNEL=
