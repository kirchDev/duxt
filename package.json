{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@kirchdev/duxt",
  "version": "0.0.0",
  "description": "Nuxt documentation layer on Content v3 — multi-repo, versioned docs from one compact source list.",
  "keywords": [
    "content-v3",
    "docs",
    "documentation",
    "duxt",
    "kirchdev",
    "nuxt",
    "nuxt-content",
    "nuxt-layer",
    "nuxt-module",
    "versioned-docs"
  ],
  "homepage": "https://github.com/kirchDev/duxt#readme",
  "bugs": {
    "url": "https://github.com/kirchDev/duxt/issues"
  },
  "license": "MIT",
  "author": "Titus Kirch <titus.kirch@kirch.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirchDev/duxt.git"
  },
  "files": [
    "app",
    "components.json",
    "content.config.ts",
    "duxt.sources.ts",
    "nuxt.config.ts",
    "server",
    "sources.ts",
    "sources-resolve.ts"
  ],
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./sources": "./sources.ts",
    "./sources-resolve": "./sources-resolve.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm typecheck:app && pnpm check:policy",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "check:policy": "node scripts/check-policy-parity.ts",
    "skills:update": "pnpm dlx skills@latest update -p -y",
    "taze": "taze",
    "taze:w": "taze -w",
    "prepare": "husky",
    "typecheck:app": "pnpm --filter www typecheck"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.127",
    "@iconify-json/simple-icons": "^1.2.94",
    "@lucide/vue": "^1.37.0",
    "@nuxt/content": "^3.16.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/mcp-toolkit": "^0.19.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "reka-ui": "^2.10.4",
    "shadcn-nuxt": "^2.8.2",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@types/node": "^26.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "nuxt": "^4.5.2",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "taze": "^21.1.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.2.1"
}
