{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "www",
  "version": "0.4.0",
  "private": true,
  "description": "The duxt documentation site — consumes the layer exactly as a downstream repo does.",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:cf": "NITRO_PRESET=cloudflare-module nuxt build",
    "deploy": "pnpm run build:cf && pnpm run publish:cf",
    "publish:cf": "wrangler deploy",
    "preview:cf": "pnpm run build:cf && wrangler dev",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify-json/vscode-icons": "^1.2.76",
    "@kirchdev/duxt": "workspace:*",
    "agents": "^0.20.1",
    "nuxt": "^4.5.2"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "nuxtseo-layer-devtools": "^5.3.14",
    "pg": "^8.23.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.114.0"
  }
}
