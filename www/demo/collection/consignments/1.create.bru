meta {
  name: Create a consignment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/demo/echo
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "reference": "AB-1029",
    "mode": "air"
  }
}

docs {
  The one request in this collection that books something: this site answers
  every request here, and this is the one that hands back a consignment.

  `{{token}}` is a variable rather than a value — the collection names the
  secret, and never carries it.
}
