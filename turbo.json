{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "loose",
  "agentGuidance": false,
  "ui": "stream",
  "tasks": {
    "test": {
      "outputs": []
    },
    "@kirchdev/duxt#test": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/www/nuxt.config.ts",
        "$TURBO_ROOT$/apps/www/duxt.build.ts",
        "$TURBO_ROOT$/apps/www/package.json",
        "$TURBO_ROOT$/apps/www/app/**",
        "$TURBO_ROOT$/apps/www/scripts/**",
        "$TURBO_ROOT$/apps/www/layers/**",
        "$TURBO_ROOT$/apps/www/site-layers/**",
        "$TURBO_ROOT$/apps/www/fixtures/**",
        "$TURBO_ROOT$/packages/duxt-wiki/**",
        "$TURBO_ROOT$/packages/duxt-typesense/**",
        "$TURBO_ROOT$/packages/duxt-meilisearch/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/docs/**"
      ]
    },
    "@kirchdev/duxt-typesense#test": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/duxt/app/**",
        "$TURBO_ROOT$/packages/duxt/build/**"
      ]
    },
    "www#test": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/.github/workflows/**"
      ]
    },
    "check:previews": {
      "outputs": []
    },
    "previews": {
      "cache": false
    },
    "typecheck": {
      "cache": false
    },
    "build": {
      "cache": false
    },
    "build:cf": {
      "cache": false
    },
    "check:a11y": {
      "cache": false
    },
    "check:adapters": {
      "cache": false
    },
    "check:extensions": {
      "cache": false
    },
    "check:images": {
      "cache": false
    },
    "check:keyboard": {
      "cache": false
    },
    "check:overflow": {
      "cache": false
    },
    "check:routes": {
      "cache": false
    },
    "check:seo": {
      "cache": false
    },
    "check:interactive": {
      "cache": false
    },
    "@kirchdev/duxt-meilisearch#test": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/duxt/app/**",
        "$TURBO_ROOT$/packages/duxt/build/**"
      ]
    },
    "check:wiki": {
      "cache": false
    },
    "@kirchdev/duxt-wiki#test": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/duxt/**"]
    },
    "check:wikilinks": {
      "cache": false
    },
    "check:infobox": {
      "cache": false
    }
  }
}
