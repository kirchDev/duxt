{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@duxt/*": ["./app/*"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "commitlint.config.ts",
    "lint-staged.config.ts",
    "taze.config.ts"
  ]
}
