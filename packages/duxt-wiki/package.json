{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@kirchdev/duxt-wiki",
  "version": "0.13.0",
  "description": "Opt-in shared wiki metadata and scoped Content queries for duxt.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirchDev/duxt.git",
    "directory": "packages/duxt-wiki"
  },
  "files": [
    "nuxt.config.ts",
    "duxt.build.ts",
    "module.ts",
    "metadata.ts",
    "queries.ts",
    "infobox.ts",
    "infobox-build.ts",
    "infobox-module.ts",
    "query-infobox.ts",
    "wikilinks.ts",
    "remark-wikilinks.ts",
    "wikilink-resolution.ts",
    "wiki-maintenance.ts",
    "wiki-create.ts",
    "wanted-routes.ts",
    "wiki-viewer.ts",
    "app",
    "article.ts",
    "server",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./metadata": "./metadata.ts",
    "./queries": "./queries.ts",
    "./server": "./server/utils/wiki.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "postpack": "node -e \"require('node:fs').rmSync('LICENSE', { force: true })\""
  },
  "devDependencies": {
    "@kirchdev/duxt": "workspace:*",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@kirchdev/duxt": ">=0.4.0 <1",
    "nuxt": "^4.0.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
